# Copy to .env to override. Every value has a working default for local development.

# Port this API listens on
PORT=3100

# Browser origin(s) allowed by CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173

# Payment provider base URLs (mock providers)
PROVIDER_A_BASE_URL=http://localhost:5001
PROVIDER_B_BASE_URL=http://localhost:5002

# Timeout for calls to payment providers, in milliseconds
UPSTREAM_TIMEOUT_MS=3000
